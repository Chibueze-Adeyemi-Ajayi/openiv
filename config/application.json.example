{
  "environment": "development",
  "http": {
    "port": 8081,
    "host": "0.0.0.0"
  },
  "db": {
    "host": "localhost",
    "port": 5432,
    "database": "openiv",
    "user": "postgres",
    "password": "password",
    "reactivePoolSize": 16,
    "pipeliningLimit": 256,
    "migrate": true,
    "sslMode": "disable"
  },
  "security": {
    "_comment_cors": "Enable credentials so the browser sends the HttpOnly session cookie on cross-origin XHR from Vite (:5173) to the API (:8080).",
    "corsAllowedOrigins": ["http://localhost:5173","http://localhost:5174"],
    "corsAllowedMethods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
    "corsAllowedHeaders": ["authorization", "content-type", "x-request-id"],
    "corsAllowCredentials": true,
    "maxBodyBytes": 65536,
    "rateLimitRequestsPerMinute": 600,
    "requestTimeoutMillis": 30000,
    "hstsEnabled": false,
    "hstsMaxAgeSeconds": 63072000,
    "contentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'",
    "tlsRequired": false,
    "trustedProxies": [],
    "authRequired": false
  },
  "email": {
    "_comment": "SMTP settings. Omit user/password for unauthenticated servers (Mailpit, MailHog). Set useSsl to true only for implicit TLS (port 465); for STARTTLS (port 587) leave it false.",
    "host": "smtp.example.com",
    "port": 587,
    "user": "smtp-user@example.com",
    "password": "smtp-password",
    "from": "noreply@example.com",
    "useSsl": false
  },
  "billing": {
    "_comment": "Pay-as-you-go billing via Paystack. Keys sourced from env vars first, then this block. Generate encryptionKey with:  openssl rand -base64 32",
    "_comment_rates": "Rates — beam_ingest: ₦0.10, webhook: ₦0.0001, kyc_lookup: ₦50, ai_token: ₦0.05/token, document_upload: ₦5, transaction_import: ₦0.01/row, case_open: ₦10, nfiu_return: ₦500, report_export: ₦5. Welcome credit: ₦500,000 / 30 days.",
    "paystackSecretKey": "sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "paystackPublicKey":  "pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "encryptionKey":      "REPLACE_WITH_32_BYTE_BASE64_KEY__openssl_rand_-base64_32"
  },
  "totp": {
